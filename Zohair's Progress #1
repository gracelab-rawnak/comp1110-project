def render_board(board):
    lines = [" ".join(row) for row in board]
    lines.append("1 2 3 4 5 6 7")  # adds the numbers 1 to 7 at the very bottom
    return "/n".join(lines)  # glues al the lines together with new lines in between and sends back the text
    


